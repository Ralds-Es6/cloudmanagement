# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Configuration
# Atlas Cloud Cluster (Production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/document_management_db?retryWrites=true&w=majority

# Local MongoDB (Automatic Offline Fallback)
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/document_management_db

# Cloudflare R2 Storage Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_r2_bucket_name
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-example.r2.dev

# Authentication & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Cloudflare Turnstile Configuration
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Initial Seeder Accounts Configuration
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@cloud.local
SEED_ADMIN_PASSWORD=admin123

SEED_USER_NAME=Demo User
SEED_USER_EMAIL=user@cloud.local
SEED_USER_PASSWORD=user123
